DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,0.0.0.0

# Database engine (PostgreSQL only)
DJANGO_DB_ENGINE=postgres

# PostgreSQL settings (used when DJANGO_DB_ENGINE=postgres)
DJANGO_DB_NAME=delisushio
DJANGO_DB_USER=postgres
DJANGO_DB_PASSWORD=Lucas1938
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432
DJANGO_DB_CONN_MAX_AGE=60
# Optional: disable/adjust SSL mode per environment
# DJANGO_DB_SSLMODE=prefer

# Comma-separated absolute origins (scheme required), example:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Security flags (recommended True in production)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# HSTS (recommended for HTTPS-only production)
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# Optional
DJANGO_SECURE_REFERRER_POLICY=same-origin
